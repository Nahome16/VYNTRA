ENVIRONMENT=production
APP_NAME=VYNTRA Evidence API

# Replace api.yourdomain.com with your real API domain.
API_DOMAIN=api.yourdomain.com

POSTGRES_DB=vyntra
POSTGRES_USER=vyntra
POSTGRES_PASSWORD=replace_with_a_very_strong_database_password
DATABASE_URL=postgresql+psycopg://vyntra:replace_with_a_very_strong_database_password@db:5432/vyntra

STORAGE_DIR=/data/evidence
MAX_UPLOAD_BYTES=26214400
ADMIN_API_TOKEN=replace_with_a_long_random_admin_token
JWT_SECRET=replace_with_a_long_random_jwt_secret
ADMIN_TOKEN_EXPIRE_MINUTES=720
ALLOW_LEGACY_ADMIN_TOKEN=false
CORS_ALLOWED_ORIGINS=https://app.yourdomain.com
ADMIN_ALLOWED_IPS=
AGENT_ALLOWED_IPS=

# Use only for first server boot. Set ALLOW_BOOTSTRAP=false after device creation.
ALLOW_BOOTSTRAP=false
BOOTSTRAP_COMPANY_NAME=VYNTRA Production
BOOTSTRAP_ADMIN_EMAIL=admin@empresa.com
BOOTSTRAP_ADMIN_NAME=Administrador VYNTRA
BOOTSTRAP_ADMIN_PASSWORD_HASH=replace_with_pbkdf2_sha256_hash
BOOTSTRAP_EMPLOYEE_CODE=EMP-001
BOOTSTRAP_EMPLOYEE_NAME=Empleado Inicial
BOOTSTRAP_EMPLOYEE_EMAIL=
BOOTSTRAP_EMPLOYEE_LOGIN_EMAIL=empleado@empresa.com
BOOTSTRAP_EMPLOYEE_PASSWORD_HASH=replace_with_pbkdf2_sha256_hash
BOOTSTRAP_DEVICE_NAME=first-device
BOOTSTRAP_DEVICE_TOKEN=replace_with_a_long_random_device_token
