ENVIRONMENT=production
APP_NAME=VYNTRA Evidence API

# Replace these with your real production domains.
APP_DOMAIN=app.yourdomain.com
API_DOMAIN=api.yourdomain.com
STATION_DOMAIN=station.yourdomain.com
ACME_EMAIL=admin@yourdomain.com

POSTGRES_DB=vyntra
POSTGRES_USER=vyntra
POSTGRES_PASSWORD=replace_with_a_very_strong_database_password
DATABASE_URL=postgresql+psycopg://vyntra:replace_with_a_very_strong_database_password@db:5432/vyntra

STORAGE_DIR=/data/evidence
DOWNLOADS_DIR=/data/downloads
MAX_UPLOAD_BYTES=26214400
ADMIN_API_TOKEN=replace_with_a_long_random_admin_token
# Minimo 32 caracteres aleatorios (openssl rand -base64 48). La API no arranca con placeholders.
JWT_SECRET=replace_with_a_long_random_jwt_secret
# uvicorn confia en X-Forwarded-For de estas IPs. "*" es valido porque el puerto de la
# API no se publica fuera de la red de Docker (solo Caddy/web la alcanzan).
FORWARDED_ALLOW_IPS=*
LOG_LEVEL=INFO
# Retencion RNF-13 usada por scripts/purge_retention.py.
RETENTION_EVIDENCE_DAYS=90
RETENTION_TELEMETRY_DAYS=365
ADMIN_TOKEN_EXPIRE_MINUTES=720
ALLOW_LEGACY_ADMIN_TOKEN=false
CORS_ALLOWED_ORIGINS=https://app.yourdomain.com
ADMIN_ALLOWED_IPS=
AGENT_ALLOWED_IPS=

# SMTP delivery for temporary passwords and access/reset codes.
SMTP_HOST=smtp.yourdomain.com
SMTP_PORT=587
SMTP_USERNAME=notificaciones@yourdomain.com
SMTP_PASSWORD=replace_with_smtp_password
SMTP_FROM_EMAIL=notificaciones@yourdomain.com
SMTP_FROM_NAME=VYNTRA
SMTP_USE_TLS=true
SMTP_USE_SSL=false
SMTP_TIMEOUT_SECONDS=10
APP_PUBLIC_URL=https://app.yourdomain.com
STATION_PUBLIC_URL=https://station.yourdomain.com/estacion

# Facturacion mensual a empresas (consola sistema). USD 15.00 por usuario monitoreado activo,
# periodos del 15 al 14 del mes siguiente, vencimiento a N dias habiles de la emision.
BILLING_START_DATE=2026-09-15
BILLING_UNIT_PRICE_CENTS=1500
BILLING_CURRENCY=USD
BILLING_DUE_BUSINESS_DAYS=4
BILLING_CONTACT_EMAIL=notificaciones@vyntralab.com
BILLING_LOGO_URL=https://app.vyntralab.com/brand/vyntra-wordmark-white.png
# Datos bancarios que aparecen en la factura. Completar SOLO en el .env del servidor;
# nunca subir valores reales al repositorio (es publico). Vacios = "te enviaremos los datos".
BILLING_BANK_NAME=
BILLING_ACCOUNT_NUMBER=
BILLING_IBAN=
BILLING_ACCOUNT_HOLDER=

# Use only for first server boot. Set ALLOW_BOOTSTRAP=false after device creation.
ALLOW_BOOTSTRAP=false
BOOTSTRAP_COMPANY_NAME=VYNTRA Production
BOOTSTRAP_EMPLOYEE_LIMIT=0
BOOTSTRAP_ADMIN_EMAIL=admin@empresa.com
BOOTSTRAP_ADMIN_NAME=Administrador VYNTRA
BOOTSTRAP_ADMIN_PASSWORD_HASH=replace_with_pbkdf2_sha256_hash
BOOTSTRAP_SYSTEM_ADMIN_EMAIL=sistema@empresa.com
BOOTSTRAP_SYSTEM_ADMIN_NAME=Administrador del sistema
BOOTSTRAP_SYSTEM_ADMIN_PASSWORD_HASH=replace_with_pbkdf2_sha256_hash
BOOTSTRAP_EMPLOYEE_CODE=EMP-001
BOOTSTRAP_EMPLOYEE_NAME=Empleado Inicial
BOOTSTRAP_EMPLOYEE_EMAIL=
BOOTSTRAP_EMPLOYEE_LOGIN_EMAIL=empleado@empresa.com
BOOTSTRAP_EMPLOYEE_PASSWORD_HASH=replace_with_pbkdf2_sha256_hash
BOOTSTRAP_DEVICE_NAME=first-device
BOOTSTRAP_DEVICE_TOKEN=replace_with_a_long_random_device_token
