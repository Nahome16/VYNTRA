{
  "manifest_version": 3,
  "name": "VYNTRA Browser",
  "description": "Extension para agregar actividad y capturas autorizadas del navegador a la estacion de marcaje web VYNTRA.",
  "version": "0.2.2",
  "action": {
    "default_popup": "popup.html",
    "default_title": "VYNTRA Browser"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": ["content-script.js"],
      "run_at": "document_start"
    }
  ],
  "host_permissions": [
    "<all_urls>",
    "https://vyntralab.tech/*",
    "https://www.vyntralab.tech/*",
    "http://localhost:3000/*",
    "http://localhost:3001/*"
  ],
  "permissions": [
    "activeTab",
    "alarms",
    "idle",
    "storage",
    "tabs"
  ]
}
