{
  "manifest_version": 3,
  "name": "VYNTRA Browser (DEV)",
  "description": "Build de desarrollo de VYNTRA Browser: acepta tambien la estacion en localhost. No distribuir.",
  "version": "0.3.1",
  "version_name": "0.3.1-dev",
  "action": {
    "default_popup": "popup.html",
    "default_title": "VYNTRA Browser (DEV)"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://vyntralab.tech/*",
        "https://www.vyntralab.tech/*",
        "http://localhost:3000/*",
        "http://localhost:3001/*"
      ],
      "js": ["content-script.js"],
      "run_at": "document_start"
    }
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "permissions": [
    "activeTab",
    "alarms",
    "idle",
    "scripting",
    "storage",
    "tabs"
  ]
}
